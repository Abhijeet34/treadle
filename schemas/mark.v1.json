{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mark.v1.json",
  "title": "mark/1",
  "description": "Set the severity or the priority of one item, with the reason and both values in the log.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "code",
    "command",
    "workspace",
    "effect",
    "txn",
    "changed",
    "data"
  ],
  "properties": {
    "schema": {
      "const": "mark/1"
    },
    "ok": {
      "type": "boolean"
    },
    "code": {
      "enum": [
        "OK",
        "VALIDATION",
        "GUARD_REFUSED",
        "CONFLICT",
        "NOT_FOUND",
        "STORE_UNAVAILABLE",
        "INTERNAL",
        "INTEGRITY"
      ]
    },
    "command": {
      "const": "mark"
    },
    "workspace": {
      "type": "string"
    },
    "effect": {
      "const": "mutate"
    },
    "txn": {
      "type": [
        "string",
        "null"
      ]
    },
    "changed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": [
            "string",
            "null"
          ]
        },
        "v": {
          "type": [
            "string",
            "null"
          ]
        },
        "set": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "already": {
          "type": [
            "string",
            "null"
          ]
        },
        "dry_run": {
          "type": [
            "integer",
            "null"
          ]
        },
        "preview": {
          "type": [
            "integer",
            "null"
          ]
        },
        "would_exit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "store": {
          "type": [
            "string",
            "null"
          ]
        },
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
