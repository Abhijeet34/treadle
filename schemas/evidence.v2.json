{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.v2.json",
  "title": "evidence/2",
  "description": "Append one bounded pointer at an artefact a third party can open.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "code",
    "command",
    "workspace",
    "effect",
    "txn",
    "changed",
    "data"
  ],
  "properties": {
    "schema": {
      "const": "evidence/2"
    },
    "ok": {
      "type": "boolean"
    },
    "code": {
      "enum": [
        "OK",
        "VALIDATION",
        "GUARD_REFUSED",
        "CONFLICT",
        "NOT_FOUND",
        "STORE_UNAVAILABLE",
        "INTERNAL",
        "INTEGRITY"
      ]
    },
    "command": {
      "const": "evidence"
    },
    "workspace": {
      "type": "string"
    },
    "effect": {
      "const": "mutate"
    },
    "txn": {
      "type": [
        "string",
        "null"
      ]
    },
    "changed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": [
            "string",
            "null"
          ]
        },
        "v": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "x-trust": "data"
        },
        "label": {
          "type": "string",
          "x-trust": "data"
        },
        "entries": {
          "type": [
            "string",
            "null"
          ]
        },
        "dry_run": {
          "type": [
            "integer",
            "null"
          ]
        },
        "would_exit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "store": {
          "type": [
            "string",
            "null"
          ]
        },
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
