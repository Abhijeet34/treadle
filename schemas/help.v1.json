{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "help.v1.json",
  "title": "help/1",
  "description": "Print the command inventory, or one command's contract, flags and examples.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "code",
    "command",
    "workspace",
    "effect",
    "txn",
    "changed",
    "data"
  ],
  "properties": {
    "schema": {
      "const": "help/1"
    },
    "ok": {
      "type": "boolean"
    },
    "code": {
      "enum": [
        "OK",
        "VALIDATION",
        "GUARD_REFUSED",
        "CONFLICT",
        "NOT_FOUND",
        "STORE_UNAVAILABLE",
        "INTERNAL",
        "INTEGRITY"
      ]
    },
    "command": {
      "const": "help"
    },
    "workspace": {
      "type": "string"
    },
    "effect": {
      "const": "read"
    },
    "txn": {
      "type": [
        "string",
        "null"
      ]
    },
    "changed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topic": {
          "type": [
            "string",
            "null"
          ]
        },
        "effect": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "about": {
          "type": "string",
          "x-trust": "data"
        },
        "example": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exit": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "columns",
            "shown",
            "total",
            "rows"
          ],
          "properties": {
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "text": {
                    "const": true
                  }
                }
              }
            },
            "shown": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "x-columns": [
            {
              "name": "name"
            },
            {
              "name": "effect"
            },
            {
              "name": "pageable"
            },
            {
              "name": "summary",
              "trust": "data"
            }
          ]
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "columns",
            "shown",
            "total",
            "rows"
          ],
          "properties": {
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "text": {
                    "const": true
                  }
                }
              }
            },
            "shown": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "x-columns": [
            {
              "name": "flag"
            },
            {
              "name": "verdict"
            },
            {
              "name": "note",
              "trust": "data"
            }
          ]
        }
      }
    }
  }
}
