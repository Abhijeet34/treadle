{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "show.v1.json",
  "title": "show/1",
  "description": "Print the stored fields of one item.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "code",
    "command",
    "workspace",
    "effect",
    "txn",
    "changed",
    "data"
  ],
  "properties": {
    "schema": {
      "const": "show/1"
    },
    "ok": {
      "type": "boolean"
    },
    "code": {
      "enum": [
        "OK",
        "VALIDATION",
        "GUARD_REFUSED",
        "CONFLICT",
        "NOT_FOUND",
        "STORE_UNAVAILABLE",
        "INTERNAL"
      ]
    },
    "command": {
      "const": "show"
    },
    "workspace": {
      "type": "string"
    },
    "effect": {
      "const": "read"
    },
    "txn": {
      "type": [
        "string",
        "null"
      ]
    },
    "changed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "filed": {
          "type": [
            "string",
            "null"
          ]
        },
        "v": {
          "type": [
            "integer",
            "null"
          ]
        },
        "pts": {
          "type": [
            "integer",
            "null"
          ]
        },
        "pri": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "ac": {
          "type": [
            "string",
            "null"
          ]
        },
        "assignee": {
          "type": "string",
          "x-trust": "data"
        },
        "title": {
          "type": "string",
          "x-trust": "data"
        },
        "desc": {
          "type": "string",
          "x-trust": "data"
        }
      }
    }
  }
}
