{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "show.v1.json",
  "title": "show/1",
  "description": "Print the stored fields of one item.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "code",
    "command",
    "workspace",
    "effect",
    "txn",
    "changed",
    "data"
  ],
  "properties": {
    "schema": {
      "const": "show/1"
    },
    "ok": {
      "type": "boolean"
    },
    "code": {
      "enum": [
        "OK",
        "VALIDATION",
        "GUARD_REFUSED",
        "CONFLICT",
        "NOT_FOUND",
        "STORE_UNAVAILABLE",
        "INTERNAL"
      ]
    },
    "command": {
      "const": "show"
    },
    "workspace": {
      "type": "string"
    },
    "effect": {
      "const": "read"
    },
    "txn": {
      "type": [
        "string",
        "null"
      ]
    },
    "changed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "filed": {
          "type": [
            "string",
            "null"
          ]
        },
        "v": {
          "type": [
            "integer",
            "null"
          ]
        },
        "pts": {
          "type": [
            "integer",
            "null"
          ]
        },
        "pri": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "ac": {
          "type": [
            "string",
            "null"
          ]
        },
        "due": {
          "type": [
            "string",
            "null"
          ]
        },
        "overdue": {
          "type": [
            "integer",
            "null"
          ]
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        },
        "assignee": {
          "type": "string",
          "x-trust": "data"
        },
        "title": {
          "type": "string",
          "x-trust": "data"
        },
        "desc": {
          "type": "string",
          "x-trust": "data"
        },
        "sev": {
          "type": [
            "string",
            "null"
          ]
        },
        "hrs": {
          "type": [
            "integer",
            "null"
          ]
        },
        "labels": {
          "type": [
            "string",
            "null"
          ]
        },
        "found": {
          "type": [
            "string",
            "null"
          ]
        },
        "fixed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "timebox": {
          "type": [
            "integer",
            "null"
          ]
        },
        "hold_until": {
          "type": [
            "string",
            "null"
          ]
        },
        "held_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "extra": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reporter": {
          "type": "string",
          "x-trust": "data"
        },
        "reviewer": {
          "type": "string",
          "x-trust": "data"
        },
        "component": {
          "type": "string",
          "x-trust": "data"
        },
        "hold": {
          "type": "string",
          "x-trust": "data"
        },
        "outcome": {
          "type": "string",
          "x-trust": "data"
        },
        "question": {
          "type": "string",
          "x-trust": "data"
        },
        "repro": {
          "type": "string",
          "x-trust": "data"
        },
        "expected": {
          "type": "string",
          "x-trust": "data"
        },
        "actual": {
          "type": "string",
          "x-trust": "data"
        },
        "findings": {
          "type": "string",
          "x-trust": "data"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "columns",
            "shown",
            "total",
            "rows"
          ],
          "properties": {
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "text": {
                    "const": true
                  }
                }
              }
            },
            "shown": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "x-columns": [
            {
              "name": "kind"
            },
            {
              "name": "ref"
            },
            {
              "name": "label",
              "trust": "data"
            }
          ]
        }
      }
    }
  }
}
