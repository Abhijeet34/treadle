{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.v1.json",
  "title": "config/1",
  "description": "Read every configuration key with the value in force and its source, or set one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "code",
    "command",
    "workspace",
    "effect",
    "txn",
    "changed",
    "data"
  ],
  "properties": {
    "schema": {
      "const": "config/1"
    },
    "ok": {
      "type": "boolean"
    },
    "code": {
      "enum": [
        "OK",
        "VALIDATION",
        "GUARD_REFUSED",
        "CONFLICT",
        "NOT_FOUND",
        "STORE_UNAVAILABLE",
        "INTERNAL",
        "INTEGRITY"
      ]
    },
    "command": {
      "const": "config"
    },
    "workspace": {
      "type": "string"
    },
    "effect": {
      "const": "mutate"
    },
    "txn": {
      "type": [
        "string",
        "null"
      ]
    },
    "changed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "v": {
          "type": [
            "string",
            "null"
          ]
        },
        "set": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-trust": "data"
        },
        "already": {
          "type": [
            "string",
            "null"
          ]
        },
        "dry_run": {
          "type": [
            "integer",
            "null"
          ]
        },
        "preview": {
          "type": [
            "integer",
            "null"
          ]
        },
        "would_exit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "store": {
          "type": [
            "string",
            "null"
          ]
        },
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "extra": {
          "type": [
            "integer",
            "null"
          ]
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "columns",
            "shown",
            "total",
            "rows"
          ],
          "properties": {
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "text": {
                    "const": true
                  },
                  "data": {
                    "const": true
                  }
                }
              }
            },
            "shown": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "x-columns": [
            {
              "name": "key"
            },
            {
              "name": "source"
            },
            {
              "name": "value",
              "trust": "data"
            }
          ]
        }
      }
    }
  }
}
