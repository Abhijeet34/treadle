{
  "name": "@abhijeet34/treadling",
  "version": "0.2.1",
  "description": "The record of the work between people and agents, over files you commit to git.",
  "license": "Apache-2.0",
  "bin": {
    "treadling": "dist/treadling.js"
  },
  "author": "Abhijeet Halder",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "files": [
    "dist/",
    "schemas/",
    "LICENSE",
    "NOTICE",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "keywords": [
    "backlog",
    "issue-tracker",
    "work-management",
    "audit-log",
    "decision-record",
    "cli",
    "local-first",
    "git-native",
    "plaintext",
    "agent-tools",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhijeet34/treadling.git"
  },
  "bugs": {
    "url": "https://github.com/Abhijeet34/treadling/issues"
  },
  "homepage": "https://github.com/Abhijeet34/treadling#readme",
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "coverage": "node scripts/coverage.ts",
    "flake": "node scripts/flake.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "commitlint": "commitlint --config scripts/commitlint.config.js --from origin/main --to HEAD",
    "schemas": "node scripts/generate-schemas.ts",
    "bench": "node bench/main.ts",
    "bench:gate": "node bench/main.ts --gate",
    "audit": "npm audit --audit-level=low",
    "licences": "node scripts/check-licences.ts",
    "tests-kept": "node scripts/check-tests-kept.ts",
    "ruleset-drift": "node scripts/check-ruleset-drift.ts"
  },
  "devDependencies": {
    "@anthropic-ai/tokenizer": "0.0.4",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^24.7.0",
    "esbuild": "^0.28.2",
    "gpt-tokenizer": "4.0.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
